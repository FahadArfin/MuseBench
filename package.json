{
  "name": "musebench",
  "version": "0.2.0",
  "private": true,
  "description": "A local coding workspace for Muse CLI",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build:icon": "node scripts/build-app-icon.mjs",
    "preview:ui": "vite --config vite.preview.config.mjs",
    "test:browser-preview": "node scripts/browser-preview-smoke.mjs",
    "test:chat-organization": "node scripts/chat-organization-smoke.mjs",
    "test:code-responsiveness": "node scripts/code-render-responsiveness-smoke.mjs && node scripts/dictation-subscription-smoke.mjs && node scripts/timeline-performance-regression.mjs",
    "test:navigation-cache": "node scripts/navigation-cache-smoke.mjs",
    "test:onboarding-preview": "node scripts/onboarding-preview-smoke.mjs",
    "test:catalog-preview": "node scripts/catalog-preview-smoke.mjs && node scripts/catalog-refinement-smoke.mjs && node scripts/project-mcp-smoke.mjs",
    "test:catalog-desktop": "node scripts/catalog-desktop-smoke.mjs && node scripts/project-mcp-smoke.mjs --desktop",
    "test:billing-preview": "node scripts/billing-smoke.mjs",
    "test:billing-desktop": "node scripts/billing-smoke.mjs --desktop",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build-native.mjs && tsc --noEmit && vite build",
    "pretest": "node -e \"require('electron')\" && node scripts/build-native.mjs",
    "test": "node --test --test-concurrency=4 test/*.test.mjs reference/patchlight/adapter/test/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "doctor": "node scripts/doctor.mjs",
    "doctor:host": "node scripts/probe-muse.mjs",
    "test:redesign": "node scripts/redesign-smoke.mjs",
    "spaces:server": "node scripts/spaces-server.mjs",
    "test:spaces": "node scripts/spaces-smoke.mjs",
    "preview:snapshots": "node scripts/capture-preview-snapshots.mjs",
    "test:preview-parity": "node scripts/preview-parity.mjs",
    "test:motion": "node scripts/motion-smoke.mjs && node scripts/motion-smoke.mjs --desktop",
    "test:activity": "node scripts/activity-smoke.mjs",
    "test:child-inspection": "node scripts/child-inspection-smoke.mjs && node scripts/child-inspection-smoke.mjs --desktop",
    "test:native-failure": "node scripts/native-failure-smoke.mjs && node scripts/native-failure-smoke.mjs --desktop",
    "test:typography": "node scripts/typography-smoke.mjs",
    "test:profile-identity": "node scripts/profile-identity-smoke.mjs && node scripts/profile-account-desktop-smoke.mjs",
    "test:startup-animation": "node scripts/startup-animation-smoke.mjs",
    "test:session-recovery": "node scripts/sidebar-loading-smoke.mjs && node scripts/session-durability-smoke.mjs",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "build:mobile": "tsc -p mobile/tsconfig.json && vite build --config vite.mobile.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@muse-code/sdk": "1.4.14",
    "electron-updater": "6.8.11",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "selfsigned": "5.5.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "js-yaml": "4.3.2",
    "playwright": "^1.58.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.musebench.desktop",
    "productName": "MuseBench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/controller/**/*",
      "src/work/**/*",
      "src/spaces/**/*",
      "src/sites/**/*",
      "src/runtime/**/*",
      "reference/patchlight/adapter/*.mjs",
      "reference/patchlight/adapter/THIRD-PARTY-NOTICE.md",
      "reference/patchlight/adapter/evidence/LICENSE",
      "templates/**/*",
      "package.json",
      "src/shared/*.mjs"
    ],
    "win": {
      "target": "dir",
      "icon": "electron/assets/musebench.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "native/bin/MuseBenchJob.exe",
          "to": "native/MuseBenchJob.exe"
        },
        {
          "from": "native/bin/MuseBenchJob.build.json",
          "to": "native/MuseBenchJob.build.json"
        },
        {
          "from": "native/bin/MuseBenchSpeech.exe",
          "to": "native/MuseBenchSpeech.exe"
        },
        {
          "from": "native/bin/MuseBenchSpeech.build.json",
          "to": "native/MuseBenchSpeech.build.json"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FahadArfin",
        "repo": "MuseBench",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MuseBench-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "electron/assets/musebench.png",
      "artifactName": "MuseBench-${version}-linux-${arch}.${ext}",
      "maintainer": "MuseBench contributors",
      "executableName": "musebench"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/musebench.png",
      "artifactName": "MuseBench-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    }
  }
}
